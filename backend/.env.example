BACKEND_PORT=3001
# Used only by telegram-bot.js. The API server starts without these.
# Set the token in the terminal. Do not commit it or paste it into chat.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_PUBLIC_BASE_URL=https://recorder.example.com
# TELEGRAM_ALLOWED_USER_IDS=123456789
# Same hostname as TELEGRAM_PUBLIC_BASE_URL. The Vercel Mini App calls this.
# RECORDER_ORIGIN=https://recorder.example.com
# Shared with the Vercel project. Generate it locally. Do not commit the value.
# RECORDER_RELAY_KEY=
# When both are set, keep-alive runs `cloudflared tunnel run` and keeps this hostname.
# CLOUDFLARE_TUNNEL_NAME=x-space-recorder
# Set to 1 when cloudflared is already running as a Windows service.
# CLOUDFLARE_TUNNEL_EXTERNAL=
# Optional. When unset, the app generates a key and stores it in SQLite.
# X_CONN_ENC_KEY=
# Optional. Defaults to backend/data/app.db
# DATABASE_PATH=
